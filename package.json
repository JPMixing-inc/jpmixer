{
  "name": "jpmixer",
  "version": "1.8.0",
  "description": "JPMixer — browser-based monitor mix control for DiGiCo consoles",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "rm -rf dist && electron-builder --mac dmg --universal --publish never",
    "build:dmg": "rm -rf dist && electron-builder --mac dmg --universal --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.jpmixing.oscmixer",
    "productName": "JPMixer",
    "npmRebuild": false,
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!assets/icon.iconset",
      "!assets/trayTemplateFinal.png",
      "!assets/DMG background.png",
      "!assets/DMG Icon and App Icon.png",
      "!assets/ScreenShots/**",
      "!assets/design/**",
      "!assets/Icons For instruments/*.zip",
      "!assets/Icons For instruments/120-PNG-Images-MusicalInstrumentsBundle/**",
      "!src/**/*.test.js",
      "!src/server/_fake-electron-for-tests.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64", "ia32"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "dmg": {
      "title": "JPMixer-${version}",
      "icon": "assets/icon.icns"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "osc": "^2.4.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  }
}
