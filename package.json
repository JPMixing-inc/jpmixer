{
  "name": "jpmixer",
  "version": "2.0.17",
  "description": "JPMixer — browser-based monitor mixes and production Home pages for DiGiCo, dLive, KLANG and WING consoles",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js src/server/*.test.js",
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "rm -rf dist && electron-builder --mac dmg --universal --publish never && rm -rf dist/mac-universal dist/*.blockmap dist/builder-debug.yml dist/latest-mac.yml",
    "build:dmg": "rm -rf dist && electron-builder --mac dmg --universal --publish never && rm -rf dist/mac-universal dist/*.blockmap dist/builder-debug.yml dist/latest-mac.yml",
    "build:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.jpmixing.oscmixer",
    "productName": "JPMixer",
    "npmRebuild": false,
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!assets/icon.iconset",
      "!assets/trayTemplateFinal.png",
      "!assets/DMG background.png",
      "!assets/DMG Icon and App Icon.png",
      "!assets/ScreenShots/**",
      "!assets/brand/*.gif",
      "!assets/design/**",
      "!assets/Icons For instruments/*.zip",
      "!assets/Icons For instruments/120-PNG-Images-MusicalInstrumentsBundle/**",
      "!src/**/*.test.js",
      "!src/server/_fake-electron-for-tests.js"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "catalog.json",
          "official-history.json",
          "patch/**/*",
          "smaart/**/*",
          "shure/**/*",
          "companion/**/*",
          "custom-pages/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "JPMixer talks to your mixing console and to the phones, tablets and computers on this network that open its mixer pages."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "dmg": {
      "title": "JPMixer-${version}",
      "icon": "assets/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": "jpmplugin",
        "name": "JPMixer Plugin",
        "description": "JPMixer plugin",
        "role": "Viewer"
      }
    ],
    "afterSign": "scripts/notarize.cjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "osc": "^2.4.4",
    "qrcode-generator": "2.0.4",
    "ws": "^8.18.3",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  }
}
